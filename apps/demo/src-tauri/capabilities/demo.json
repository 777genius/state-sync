{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "demo-windows",
  "description": "Permissions for demo windows",
  "windows": ["demo-*", "benchmark"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen"
  ]
}
