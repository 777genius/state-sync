{
  "name": "@statesync/electron",
  "version": "1.0.0",
  "description": "Electron transport layer for state-sync — IPC bridge, broadcaster, and snapshot handler",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "777genius <iliyazelenkog@gmail.com>",
  "keywords": [
    "state-sync",
    "electron",
    "transport",
    "ipc",
    "synchronization",
    "multi-window",
    "contextBridge",
    "state-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/777genius/state-sync.git",
    "directory": "packages/electron"
  },
  "bugs": "https://github.com/777genius/state-sync/issues",
  "homepage": "https://github.com/777genius/state-sync#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@statesync/core": "^1.1.0",
    "electron": ">=28"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "@statesync/core": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
